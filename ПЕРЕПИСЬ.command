#!/bin/bash
# ПЕРЕПИСЬ ПО ШКОЛАМ (ночь без тяжёлых шагов): окно 01.10.2025–01.10.2026, все каналы (запросы, хэштеги,
# ленты авторов), без лимита постов, таблица постов + слайды; БЕЗ видео, Whisper и комментариев.
# В ИТОГ по каждой школе — лист «Покрытие» с вердиктом. Комментарии/Whisper — потом, отдельным запуском.
cd "$(dirname "$0")"
exec bash "./НА_НОЧЬ.command" --plan plan_census.txt --redo --search-only --no-videos --whisper off "$@"
