#!/bin/bash
# ГЛУБИНА по уже собранным постам (после ПЕРЕПИСЬ.command): выборка на школу (SAMPLE в pipeline.py, по умолчанию 300:
# все посты с >=2 школами + пропорционально официальные/амбассадоры/UGC) -> скачивание видео + комментарии и реплаи
# (COMMENTS в pipeline.py = 200 на пост) параллельно по аккаунтам; затем ОДНИМ процессом Whisper (где нет субтитров TikTok,
# с фильтром галлюцинаций) и текст с кадров видео через API. В ИТОГ: колонки «Транскрипт (Whisper)», «Текст на экране (видео)»,
# «В выборке (глубина)», «Школы упомянуты (все поля)». Повторный запуск продолжает с места обрыва.
cd "$(dirname "$0")"
exec bash "./НА_НОЧЬ.command" --plan plan_census.txt --heavy --redo "$@"
